# =================================================================
# NexusHR Backend Environment Variables Example Configuration
# Copy this file to .env and adjust the values according to your environment.
# =================================================================

# Server Port
PORT=8080

# Active Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexushr_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/nexushr_db

# JPA / Hibernate Settings
JPA_DDL_AUTO=update
SHOW_SQL=true

# Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# JWT Configuration (for future authentication phases)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
